# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform API key for interactive maps.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL Runtime Environment Variables (injected automatically by Cloud SQL setup)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional SMTP settings for automated citizen/admin email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@waghodiajansamvad.org"
